<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer policy. Paired with
  android:allowBackup="false" and android:fullBackupContent="false" for
  older APIs. This is a remittance app: auth tokens, refresh tokens and
  member/MPIN state live in shared_preferences, so NOTHING may leave the
  device. Excluding everything from both channels prevents a reinstall (or a
  device-to-device transfer) from restoring a previous user's session and
  booting straight into their MPIN lock screen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>